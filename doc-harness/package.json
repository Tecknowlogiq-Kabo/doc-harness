{
  "name": "doc-harness",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm --filter @doc-harness/web dev",
    "build": "pnpm --filter @doc-harness/core build && pnpm --filter @doc-harness/web build",
